# Copy this file into an example folder as providers.tf to run `terraform plan`
# WITHOUT an AWS account. The provider skips every credential/API check, and
# no example uses data sources that call AWS, so planning works offline.
# Never `apply` with this configuration.
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 6.0"
    }
  }
}

provider "aws" {
  region                      = "us-east-1"
  access_key                  = "mock"
  secret_key                  = "mock"
  skip_credentials_validation = true
  skip_requesting_account_id  = true
  skip_metadata_api_check     = true
  skip_region_validation      = true
}
